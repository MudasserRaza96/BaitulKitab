@model Baitul_Kitab.Models.DTO.UserStore.CartDTO
@{
    ViewData["Title"] = "My Shopping Cart";
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<section class="content pt-3">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent p-0">
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Books">Books</a></li>
                <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
            </ol>
        </nav>

        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="h4 mb-0 font-weight-bold">
                <i class="fas fa-shopping-cart text-primary mr-2"></i>My Shopping Cart
                @if (Model != null && !Model.IsEmpty)
                {
                    <span class="badge badge-light border text-muted ml-2 font-weight-normal font-size-sm">
                        <span id="cartItemsCountText">@Model.TotalItems</span> items
                    </span>
                }
            </h1>
            @if (Model != null && !Model.IsEmpty)
            {
                <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i>Continue Shopping
                </a>
            }
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle mr-1"></i>@TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle mr-1"></i>@TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        @if (Model == null || Model.IsEmpty)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-5 text-center">
                    <div class="my-4">
                        <i class="fas fa-shopping-basket fa-4x text-muted mb-3"></i>
                        <h4 class="font-weight-bold text-dark">Your cart is currently empty</h4>
                        <p class="text-muted">You have not added any books to your shopping cart yet.</p>
                        <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-primary px-4 py-2 mt-2">
                            <i class="fas fa-book-open mr-2"></i>Explore & Browse Books
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="cartTable">
                                <thead class="bg-light">
                                    <tr>
                                        <th style="min-width: 250px;">Book</th>
                                        <th class="text-right" style="width: 110px;">Price</th>
                                        <th class="text-center" style="width: 150px;">Quantity</th>
                                        <th class="text-right" style="width: 120px;">Total</th>
                                        <th class="text-center" style="width: 60px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr id="cartRow-@item.BookId" class="cart-item-row" data-book-id="@item.BookId">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <a asp-area="User" asp-controller="Store" asp-action="Details" asp-route-id="@item.BookId" class="mr-3 flex-shrink-0">
                                                        @if (!string.IsNullOrWhiteSpace(item.CoverImage))
                                                        {
                                                            <img src="@item.CoverImage" alt="@item.Title" class="rounded shadow-sm" style="width: 50px; height: 68px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="rounded bg-light border d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 68px;">
                                                                <i class="fas fa-book fa-lg"></i>
                                                            </div>
                                                        }
                                                    </a>
                                                    <div>
                                                        <a asp-area="User" asp-controller="Store" asp-action="Details" asp-route-id="@item.BookId" class="font-weight-bold text-dark text-decoration-none">
                                                            @item.Title
                                                        </a>
                                                        <div class="small text-muted">by @(item.AuthorName ?? "Unknown author")</div>
                                                        @if (item.StockQuantity <= 5)
                                                        {
                                                            <span class="badge badge-warning">Only @item.StockQuantity left</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-success">In Stock</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-right align-middle">
                                                <span class="font-weight-bold">@item.Price.ToString("N2")</span>
                                                @if (item.HasDiscount)
                                                {
                                                    <div class="small text-muted text-decoration-line-through"><del>@item.OriginalPrice?.ToString("N2")</del></div>
                                                }
                                            </td>
                                            <td class="text-center align-middle">
                                                <form asp-area="User" asp-controller="Store" asp-action="UpdateCartQuantity" method="post" class="cart-qty-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookId" value="@item.BookId" />
                                                    <div class="input-group input-group-sm mx-auto" style="width: 110px;">
                                                        <div class="input-group-prepend">
                                                            <button class="btn btn-outline-secondary btn-cart-minus" type="button" title="Decrease">
                                                                <i class="fas fa-minus fa-xs"></i>
                                                            </button>
                                                        </div>
                                                        <input type="number" name="quantity" class="form-control text-center font-weight-bold cart-qty-input"
                                                               value="@item.Quantity" min="1" max="@item.StockQuantity" data-book-id="@item.BookId" />
                                                        <div class="input-group-append">
                                                            <button class="btn btn-outline-secondary btn-cart-plus" type="button" title="Increase">
                                                                <i class="fas fa-plus fa-xs"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="text-right align-middle">
                                                <span class="font-weight-bold text-primary cart-item-total" id="itemTotal-@item.BookId">@item.Total.ToString("N2")</span>
                                            </td>
                                            <td class="text-center align-middle">
                                                <form asp-area="User" asp-controller="Store" asp-action="RemoveFromCart" method="post" class="cart-remove-form d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookId" value="@item.BookId" />
                                                    <button type="submit" class="btn btn-link text-danger p-0 btn-remove-item" title="Remove book">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                            <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-arrow-left mr-1"></i>Continue Shopping
                            </a>
                            <form asp-area="User" asp-controller="Store" asp-action="ClearCart" method="post" onsubmit="return confirm('Are you sure you want to clear your shopping cart?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash mr-1"></i>Clear Cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm border-0 sticky-top" style="top: 80px;">
                        <div class="card-header bg-light py-3">
                            <h6 class="font-weight-bold mb-0">Order Summary</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Subtotal (<span id="summaryTotalItems">@Model.TotalItems</span> items)</span>
                                <span class="font-weight-bold" id="cartSubtotalText">@Model.Subtotal.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Shipping</span>
                                <span class="badge badge-success py-1 px-2">Free Delivery</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between mb-3 align-items-center">
                                <span class="h6 font-weight-bold mb-0">Total</span>
                                <span class="h4 font-weight-bold text-primary mb-0" id="cartGrandTotalText">@Model.GrandTotal.ToString("N2")</span>
                            </div>

                            @if (isAuthenticated)
                            {
                                <a asp-area="User" asp-controller="Store" asp-action="Checkout" class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                    <i class="fas fa-lock mr-2"></i>Proceed to Checkout
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Checkout", "Store", new { area = "User" })"
                                   class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                    <i class="fas fa-sign-in-alt mr-2"></i>Sign In to Checkout
                                </a>
                                <p class="text-muted small text-center mt-2 mb-0">
                                    Sign in or create an account to finalize your order.
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Function to update quantity via AJAX
            function updateQuantity(bookId, qty, $input) {
                var token = $('input[name="__RequestVerificationToken"]').first().val();
                $.ajax({
                    url: '@Url.Action("UpdateCartQuantity", "Store", new { area = "User" })',
                    type: 'POST',
                    data: {
                        bookId: bookId,
                        quantity: qty,
                        __RequestVerificationToken: token
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res.success) {
                            if (res.isEmpty) {
                                window.location.reload();
                                return;
                            }
                            $('#itemTotal-' + bookId).text(res.itemTotal);
                            $('#cartSubtotalText').text(res.subtotal);
                            $('#cartGrandTotalText').text(res.grandTotal);
                            $('#summaryTotalItems').text(res.count);
                            $('#cartItemsCountText').text(res.count);

                            if (typeof window.updateNavCartBadge === 'function') {
                                window.updateNavCartBadge(res.count);
                            } else {
                                $('.cart-count-badge').text(res.count).toggle(res.count > 0);
                            }
                        }
                    },
                    error: function () {
                        window.location.reload();
                    }
                });
            }

            $('.btn-cart-minus').on('click', function () {
                var $input = $(this).closest('.input-group').find('.cart-qty-input');
                var val = parseInt($input.val(), 10) || 1;
                var bookId = $input.data('book-id');
                if (val > 1) {
                    var newVal = val - 1;
                    $input.val(newVal);
                    updateQuantity(bookId, newVal, $input);
                }
            });

            $('.btn-cart-plus').on('click', function () {
                var $input = $(this).closest('.input-group').find('.cart-qty-input');
                var val = parseInt($input.val(), 10) || 1;
                var max = parseInt($input.attr('max'), 10) || 999;
                var bookId = $input.data('book-id');
                if (val < max) {
                    var newVal = val + 1;
                    $input.val(newVal);
                    updateQuantity(bookId, newVal, $input);
                }
            });

            $('.cart-qty-input').on('change', function () {
                var $input = $(this);
                var val = parseInt($input.val(), 10) || 1;
                var min = 1;
                var max = parseInt($input.attr('max'), 10) || 999;
                if (val < min) val = min;
                if (val > max) val = max;
                $input.val(val);
                var bookId = $input.data('book-id');
                updateQuantity(bookId, val, $input);
            });

            $('.cart-remove-form').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $row = $form.closest('.cart-item-row');
                var bookId = $row.data('book-id');

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res.success) {
                            if (res.isEmpty) {
                                window.location.reload();
                                return;
                            }
                            $row.fadeOut(250, function () {
                                $(this).remove();
                                $('#cartSubtotalText').text(res.subtotal);
                                $('#cartGrandTotalText').text(res.grandTotal);
                                $('#summaryTotalItems').text(res.count);
                                $('#cartItemsCountText').text(res.count);
                            });

                            if (typeof window.updateNavCartBadge === 'function') {
                                window.updateNavCartBadge(res.count);
                            } else {
                                $('.cart-count-badge').text(res.count).toggle(res.count > 0);
                            }

                            if (window.toastr) {
                                toastr.info('Book removed from cart.', 'Shopping Cart');
                            }
                        }
                    },
                    error: function () {
                        $form.off('submit').submit();
                    }
                });
            });
        });
    </script>
}
