@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-danger">
                <div class="card-body p-5">
                    <i class="fas fa-ban fa-4x text-danger mb-3"></i>
                    <h2 class="card-title text-danger">Access Denied</h2>
                    <p class="card-text text-muted">
                        You do not have permission to access this page.<br />
                        Your account's role does not allow access to this resource.
                    </p>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                        <i class="fas fa-home me-1"></i> Go to Home
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary mt-3 ms-2">
                        <i class="fas fa-sign-in-alt me-1"></i> Login with a different account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
