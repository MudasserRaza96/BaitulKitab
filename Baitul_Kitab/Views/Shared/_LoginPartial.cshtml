@using Microsoft.AspNetCore.Identity
@using Baitul_Kitab.Models

@inject SignInManager<ApplicationUser > SignInManager
@inject UserManager<ApplicationUser > UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="manage" class="nav-link text-dark font-weight-bold" asp-area="Identity" asp-page="/Account/Manage/Index" title="My Account">
            <i class="fas fa-user-circle mr-1"></i>My Account
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline d-inline" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Store", new { area = "User" })">
            <button id="logout" type="submit" class="nav-link btn btn-link text-danger border-0 font-weight-bold">
                <i class="fas fa-sign-out-alt mr-1"></i>Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-primary font-weight-bold" id="login" asp-area="Identity" asp-page="/Account/Login">
            <i class="fas fa-sign-in-alt mr-1"></i>Login
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link btn btn-sm btn-primary text-white font-weight-bold px-3 ml-2" id="register" asp-area="Identity" asp-page="/Account/Register">
            <i class="fas fa-user-plus mr-1"></i>Register
        </a>
    </li>
}
</ul>
