@{
    ViewData["Title"] = "About Us";
}

<section class="content pt-3">
    <div class="container-fluid">
        @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.TopBanner })

        <!-- Hero Header -->
        <div class="card shadow-sm border-0 mb-4 bg-primary text-white" style="border-radius: 12px; background: linear-gradient(135deg, #007bff 0%, #0a6378 100%);">
            <div class="card-body p-4 p-md-5 text-center">
                <i class="fas fa-book-reader fa-3x mb-3 text-warning"></i>
                <h1 class="display-5 font-weight-bold mb-2">Welcome to Baitul Kitab</h1>
                <p class="lead mb-0 text-white-50">Your premier destination for authentic books, knowledge, and digital literature.</p>
            </div>
        </div>

        <!-- Mission & Vision Row -->
        <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
                <div class="card h-100 shadow-sm border-0" style="border-radius: 10px;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge badge-primary p-3 rounded-circle mr-3">
                                <i class="fas fa-bullseye fa-lg"></i>
                            </span>
                            <h4 class="mb-0 font-weight-bold">Our Mission</h4>
                        </div>
                        <p class="text-muted mb-0">
                            At <strong>Baitul Kitab</strong>, our mission is to make quality literature, classical works, and contemporary titles easily accessible to readers everywhere. We strive to bridge the gap between avid readers and authentic books with effortless online browsing, fair pricing, and both print and digital editions.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0" style="border-radius: 10px;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge badge-success p-3 rounded-circle mr-3">
                                <i class="fas fa-eye fa-lg"></i>
                            </span>
                            <h4 class="mb-0 font-weight-bold">Our Vision</h4>
                        </div>
                        <p class="text-muted mb-0">
                            We envision an enlightened community empowered through lifelong learning. By curating extensive collections across diverse categories and languages, we aspire to be the most trusted bookstore platform connecting knowledge seekers with scholars, authors, and publishers.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Why Choose Us -->
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
            <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                <h3 class="font-weight-bold">Why Choose Baitul Kitab?</h3>
                <p class="text-muted">A modern bookstore platform built for a seamless reading journey</p>
            </div>
            <div class="card-body p-4">
                <div class="row text-center">
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="p-3">
                            <div class="text-primary mb-3">
                                <i class="fas fa-layer-group fa-2x"></i>
                            </div>
                            <h5 class="font-weight-bold">Extensive Catalog</h5>
                            <p class="text-muted small mb-0">Discover thousands of titles across multiple genres, categories, and languages.</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="p-3">
                            <div class="text-success mb-3">
                                <i class="fas fa-file-pdf fa-2x"></i>
                            </div>
                            <h5 class="font-weight-bold">Digital E-Books</h5>
                            <p class="text-muted small mb-0">Instant access to downloadable and readable PDF versions of selected titles.</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="p-3">
                            <div class="text-info mb-3">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                            <h5 class="font-weight-bold">Authentic &amp; Verified</h5>
                            <p class="text-muted small mb-0">Every book is cataloged with authentic metadata, ISBNs, publishers, and authors.</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="p-3">
                            <div class="text-warning mb-3">
                                <i class="fas fa-headset fa-2x"></i>
                            </div>
                            <h5 class="font-weight-bold">Dedicated Support</h5>
                            <p class="text-muted small mb-0">Our friendly support team is always ready to assist you with inquiries and requests.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Call to Action -->
        <div class="card shadow-sm border-0 mb-4 bg-light text-center" style="border-radius: 10px;">
            <div class="card-body p-4">
                <h4 class="font-weight-bold mb-2">Ready to explore our collection?</h4>
                <p class="text-muted mb-3">Search through our catalog of books and start reading today.</p>
                <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-primary px-4 py-2 mr-2">
                    <i class="fas fa-book mr-1"></i> Browse Books
                </a>
                <a asp-area="User" asp-controller="Store" asp-action="Contact" class="btn btn-outline-secondary px-4 py-2">
                    <i class="fas fa-envelope mr-1"></i> Contact Us
                </a>
            </div>
        </div>

        @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.Footer })
    </div>
</section>
