@{
    ViewData["Title"] = "Checkout";
}

<section class="content pt-3">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent p-0">
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Cart">Cart</a></li>
                <li class="breadcrumb-item active" aria-current="page">Checkout</li>
            </ol>
        </nav>

        <h1 class="h4 mb-3 font-weight-bold">
            <i class="fas fa-lock text-primary mr-2"></i>Checkout
        </h1>

        <div class="alert alert-info">
            <i class="fas fa-info-circle mr-1"></i>
            Online checkout integration is in preparation. Your account is verified and ready for upcoming orders!
        </div>

        <div class="text-center my-4">
            <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-primary">
                <i class="fas fa-book mr-1"></i>Back to Books
            </a>
        </div>
    </div>
</section>
