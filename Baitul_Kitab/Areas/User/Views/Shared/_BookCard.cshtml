@model UserBookCardDTO

<div class="card h-100 book-card">
    <a asp-area="User" asp-controller="Store" asp-action="Details" asp-route-id="@Model.Id" class="book-cover-wrap text-decoration-none">
        @if (Model.HasDiscount)
        {
            <div class="book-badge-overlay">
                <span class="badge badge-danger">Sale</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.PdfFilePath))
        {
            <div class="book-badge-overlay-left">
                <span class="badge badge-danger" title="PDF available"><i class="fas fa-file-pdf mr-1"></i>PDF</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.BookCoverImage))
        {
            <img src="@Model.BookCoverImage" class="book-cover" alt="@Model.Title" loading="lazy" />
        }
        else
        {
            <div class="book-cover book-cover-empty"><i class="fas fa-book fa-3x"></i></div>
        }
    </a>
    <div class="card-body d-flex flex-column">
        <a asp-area="User" asp-controller="Store" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none" title="@Model.Title">
            <h6 class="book-title">@Model.Title</h6>
        </a>
        <div class="book-author" title="@(Model.AuthorName ?? "Unknown author")">
            <i class="fas fa-user-edit mr-1"></i>@(Model.AuthorName ?? "Unknown author")
        </div>
        <div class="book-meta-tags">
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <span class="badge badge-info text-white">@Model.CategoryName</span>
            }
            @if (!string.IsNullOrEmpty(Model.LanguageName))
            {
                <span class="badge badge-secondary">@Model.LanguageName</span>
            }
        </div>
        <div class="mt-auto">
            <div class="book-price-stock-row">
                <div class="book-price-box">
                    @if (Model.HasDiscount)
                    {
                        <span class="book-price-value text-success">@Model.EffectivePrice.ToString("N2")</span>
                        <del class="book-price-original">@Model.Price.ToString("N2")</del>
                    }
                    else
                    {
                        <span class="book-price-value text-dark">@Model.Price.ToString("N2")</span>
                    }
                </div>
                <div>
                    @if (!Model.InStock)
                    {
                        <span class="badge badge-danger book-stock-badge">Out of Stock</span>
                    }
                    else if (Model.Quantity <= 5)
                    {
                        <span class="badge badge-warning book-stock-badge">@Model.Quantity left</span>
                    }
                    else
                    {
                        <span class="badge badge-success book-stock-badge">In Stock</span>
                    }
                </div>
            </div>
            <a asp-area="User" asp-controller="Store" asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-sm btn-outline-primary btn-block book-btn-details">
                <i class="fas fa-info-circle mr-1"></i>View Details
            </a>
        </div>
    </div>
</div>
