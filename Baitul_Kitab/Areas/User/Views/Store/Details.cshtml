@model UserBookDetailDTO
@{
    ViewData["Title"] = Model.Title;
    var showSidebarAd = AdProvider.IsEnabled(AdPlacements.Sidebar);
}

<section class="content pt-3">
    <div class="container-fluid">
        @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.TopBanner })

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent p-0">
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Books">Books</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <div class="row">
            <div class="@(showSidebarAd ? "col-lg-9" : "col-12")">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center mb-3">
                                @if (!string.IsNullOrWhiteSpace(Model.BookCoverImage))
                                {
                                    <img src="@Model.BookCoverImage" alt="@Model.Title" class="img-fluid rounded shadow-sm book-detail-cover" />
                                }
                                else
                                {
                                    <div class="book-cover book-cover-empty rounded"><i class="fas fa-book fa-5x"></i></div>
                                }
                            </div>
                            <div class="col-md-8">
                                <h1 class="h3">@Model.Title</h1>
                                <p class="text-muted">by @(Model.AuthorName ?? "Unknown author")</p>

                                <partial name="_BookPriceStock" model="Model" />

                                <div class="mt-3 mb-3">
                                    @if (Model.InStock)
                                    {
                                        <form asp-area="User" asp-controller="Store" asp-action="AddToCart" method="post" id="addToCartForm" class="d-inline-flex flex-wrap align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookId" value="@Model.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                                            <div class="input-group mr-3 mb-2" style="width: 130px;">
                                                <div class="input-group-prepend">
                                                    <button class="btn btn-outline-secondary btn-sm" type="button" id="qtyMinusBtn">
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                </div>
                                                <input type="number" name="quantity" id="bookQuantityInput" class="form-control form-control-sm text-center font-weight-bold"
                                                       value="1" min="1" max="@(Model.Quantity.GetValueOrDefault(10))" />
                                                <div class="input-group-append">
                                                    <button class="btn btn-outline-secondary btn-sm" type="button" id="qtyPlusBtn">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <button type="submit" id="addToCartButton" class="btn btn-primary mr-2 mb-2 px-3 shadow-sm font-weight-bold"
                                                    title="Add to Shopping Cart">
                                                <i class="fas fa-cart-plus mr-1"></i>Add to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" disabled class="btn btn-secondary mr-2 mb-2 px-3">
                                            <i class="fas fa-ban mr-1"></i>Out of Stock
                                        </button>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.PdfFilePath))
                                    {
                                        <a href="@Model.PdfFilePath" target="_blank" class="btn btn-outline-danger mb-2" id="viewPdfButton">
                                            <i class="fas fa-file-pdf mr-1"></i>Read / Download PDF
                                        </a>
                                    }
                                </div>

                                <dl class="row mb-0">
                                    <dt class="col-sm-4">Category</dt>
                                    <dd class="col-sm-8">@(Model.CategoryName ?? "-")</dd>
                                    <dt class="col-sm-4">Language</dt>
                                    <dd class="col-sm-8">@(Model.LanguageName ?? "-")</dd>
                                    <dt class="col-sm-4">ISBN</dt>
                                    <dd class="col-sm-8">@(Model.ISBN ?? "-")</dd>
                                    <dt class="col-sm-4">Publisher</dt>
                                    <dd class="col-sm-8">@(Model.Publisher ?? "-")</dd>
                                    <dt class="col-sm-4">Publish date</dt>
                                    <dd class="col-sm-8">@(Model.PublishDate?.ToString("dd MMM yyyy") ?? "-")</dd>
                                    <dt class="col-sm-4">Pages</dt>
                                    <dd class="col-sm-8">@(Model.Pages?.ToString() ?? "-")</dd>
                                    <dt class="col-sm-4">E-Book (PDF)</dt>
                                    <dd class="col-sm-8">
                                        @if (!string.IsNullOrWhiteSpace(Model.PdfFilePath))
                                        {
                                            <a href="@Model.PdfFilePath" target="_blank" class="text-danger font-weight-bold">
                                                <i class="fas fa-file-pdf mr-1"></i>Available for reading
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Available</span>
                                        }
                                    </dd>
                                </dl>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <hr />
                            <h2 class="h5">Description</h2>
                            <p class="mb-0" style="white-space: pre-line;">@Model.Description</p>
                        }
                    </div>
                </div>

                @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.BookDetails })
            </div>

            @if (showSidebarAd)
            {
                <aside class="col-lg-3 d-none d-lg-block">
                    <div class="sticky-top" style="top: 70px;">
                        @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.Sidebar })
                    </div>
                </aside>
            }
        </div>

        @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.Footer })
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            var $input = $('#bookQuantityInput');
            var max = parseInt($input.attr('max'), 10) || 999;
            var min = 1;

            $('#qtyMinusBtn').on('click', function () {
                var val = parseInt($input.val(), 10) || 1;
                if (val > min) {
                    $input.val(val - 1);
                }
            });

            $('#qtyPlusBtn').on('click', function () {
                var val = parseInt($input.val(), 10) || 1;
                if (val < max) {
                    $input.val(val + 1);
                }
            });

            $('#addToCartForm').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $('#addToCartButton');
                var originalHtml = $btn.html();

                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Adding...');

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        $btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i>Added!');
                        setTimeout(function () {
                            $btn.html(originalHtml);
                        }, 2000);

                        if (res.success) {
                            if (window.toastr) {
                                toastr.success(res.message, 'Shopping Cart');
                            }
                            if (typeof window.updateNavCartBadge === 'function') {
                                window.updateNavCartBadge(res.count);
                            } else {
                                $('.cart-count-badge').text(res.count).toggle(res.count > 0);
                            }
                        } else {
                            if (window.toastr) {
                                toastr.warning(res.message, 'Shopping Cart');
                            } else {
                                alert(res.message);
                            }
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                        // Fallback to normal form submit
                        $form.off('submit').submit();
                    }
                });
            });
        });
    </script>
}
