@{
    ViewData["Title"] = "My Cart";
}

<section class="content pt-3">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent p-0">
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Books">Books</a></li>
                <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
            </ol>
        </nav>

        <h1 class="h4 mb-3 font-weight-bold">
            <i class="fas fa-shopping-cart text-primary mr-2"></i>My Shopping Cart
        </h1>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4 text-center">
                        <div class="my-4">
                            <i class="fas fa-shopping-basket fa-4x text-muted mb-3"></i>
                            <h5 class="font-weight-bold text-dark">Your cart is currently empty</h5>
                            <p class="text-muted small">Explore our collection of authentic books and add them to your cart.</p>
                            <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-primary mt-2">
                                <i class="fas fa-book-open mr-1"></i>Browse Books
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light py-3">
                        <h6 class="font-weight-bold mb-0">Order Summary</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="font-weight-bold">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Estimated Shipping</span>
                            <span class="text-success font-weight-bold">Free</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <span class="h6 font-weight-bold mb-0">Total</span>
                            <span class="h5 font-weight-bold text-primary mb-0">$0.00</span>
                        </div>
                        <a asp-area="User" asp-controller="Store" asp-action="Checkout" class="btn btn-primary btn-block disabled" aria-disabled="true">
                            <i class="fas fa-lock mr-1"></i>Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
