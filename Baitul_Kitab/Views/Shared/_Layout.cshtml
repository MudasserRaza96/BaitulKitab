<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Baitul_Kitab</title>

    <!-- CSS -->
    <link href="~/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/dist/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/plugins/overlayScrollbars/css/OverlayScrollbars.min.css" rel="stylesheet" />
    <link href="~/plugins/daterangepicker/daterangepicker.css" rel="stylesheet" />
    <link href="~/plugins/summernote/summernote-bs4.min.css" rel="stylesheet" />
    <link href="~/plugins/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css" rel="stylesheet" />
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
    <link href="~/css/toastr.min.css" rel="stylesheet" />
    <link href="~/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <!-- Core JS (Load Early) -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/utilities.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
</head>
<script>
    $(document).ready(function () {
        HideLoader();
    });
</script>
@{
    bool isAdmin = User.IsInRole("Admin");
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isCategoryActive = currentArea.Equals("Category", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Category", StringComparison.OrdinalIgnoreCase);
    bool isAuthorActive = currentArea.Equals("Author", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Author", StringComparison.OrdinalIgnoreCase);
    bool isLanguageActive = currentArea.Equals("Category", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Language", StringComparison.OrdinalIgnoreCase);
    bool isBookActive = currentArea.Equals("Book", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Book", StringComparison.OrdinalIgnoreCase);

    bool isManagementActive = isCategoryActive || isAuthorActive || isLanguageActive || isBookActive;
    bool isBookConfigActive = isManagementActive;

    bool isUserHomeActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);
    bool isUserBooksActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("Books", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("Details", StringComparison.OrdinalIgnoreCase));
    bool isUserCategoriesActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Categories", StringComparison.OrdinalIgnoreCase);
    bool isUserAuthorsActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Authors", StringComparison.OrdinalIgnoreCase);
    bool isUserLanguagesActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Languages", StringComparison.OrdinalIgnoreCase);
    bool isUserCartActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Cart", StringComparison.OrdinalIgnoreCase);
    bool isUserOrdersActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Orders", StringComparison.OrdinalIgnoreCase);
    bool isUserAboutActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("About", StringComparison.OrdinalIgnoreCase);
    bool isUserContactActive = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) && currentController.Equals("Store", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Contact", StringComparison.OrdinalIgnoreCase);
}
<body class="hold-transition @(isAdmin ? "sidebar-mini layout-fixed layout-navbar-fixed" : "layout-top-nav")">
    
    <div id="global-loader">
        <div class="loader-wrapper">
            <div class="loader"></div>
            <p>Please wait...</p>
        </div>
    </div>
    <div class="wrapper">

        <!-- Navbar / Top Bar -->
        @if (isAdmin)
        {
            <!-- Admin Navbar -->
            <nav class="main-header navbar navbar-expand navbar-white navbar-light">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                            <i class="fas fa-bars"></i>
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ml-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                            <i class="fas fa-expand-arrows-alt"></i>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            @(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Guest")
                            <i class="fas fa-user-circle" style="font-size: 20px; color: #6c757d;"></i>
                        </a>
                    </li>

                    <partial name="_LoginPartial" />
                </ul>
            </nav>
        }
        else
        {
            <!-- User / Customer Top Bar Navigation -->
            <nav class="main-header navbar navbar-expand-lg navbar-light bg-white shadow-sm store-navbar">
                <div class="container-fluid px-lg-4">
                    <a href="@Url.Action("Index", "Store", new { area = "User" })" class="navbar-brand">
                        <img src="~/dist/img/AdminLTELogo.png" alt="Logo" class="brand-image img-circle elevation-2">
                        <span class="brand-text font-weight-bold">Baitul Kitab</span>
                    </a>

                    <button class="navbar-toggler order-1" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse order-3" id="navbarCollapse">
                        <!-- Left navbar links -->
                        <ul class="navbar-nav mr-auto">
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Store", new { area = "User" })" class="nav-link @(isUserHomeActive ? "active" : "")">
                                    <i class="fas fa-home"></i><span>Home</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Books", "Store", new { area = "User" })" class="nav-link @(isUserBooksActive ? "active" : "")">
                                    <i class="fas fa-book"></i><span>Books</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Categories", "Store", new { area = "User" })" class="nav-link @(isUserCategoriesActive ? "active" : "")">
                                    <i class="fas fa-th-large"></i><span>Categories</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Authors", "Store", new { area = "User" })" class="nav-link @(isUserAuthorsActive ? "active" : "")">
                                    <i class="fas fa-feather-alt"></i><span>Authors</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Languages", "Store", new { area = "User" })" class="nav-link @(isUserLanguagesActive ? "active" : "")">
                                    <i class="fas fa-globe"></i><span>Languages</span>
                                </a>
                            </li>

                            @* Protected customer navigation items: visible only when authenticated as normal user *@
                            @if (User.Identity?.IsAuthenticated == true && !isAdmin)
                            {
                                <li class="nav-item">
                                    <a href="@Url.Action("Cart", "Store", new { area = "User" })" class="nav-link @(isUserCartActive ? "active" : "")">
                                        <i class="fas fa-shopping-cart"></i><span>My Cart</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Orders", "Store", new { area = "User" })" class="nav-link @(isUserOrdersActive ? "active" : "")">
                                        <i class="fas fa-box"></i><span>My Orders</span>
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a href="@Url.Action("About", "Store", new { area = "User" })" class="nav-link @(isUserAboutActive ? "active" : "")">
                                    <i class="fas fa-info-circle"></i><span>About Us</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Contact", "Store", new { area = "User" })" class="nav-link @(isUserContactActive ? "active" : "")">
                                    <i class="fas fa-envelope"></i><span>Contact Us</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Right navbar links -->
                    <ul class="order-1 order-lg-3 navbar-nav navbar-no-expand ml-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link store-fullscreen-btn" data-widget="fullscreen" href="#" role="button" title="Full Screen">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </a>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </nav>
        }

        <!-- Sidebar: Only for Admin Module -->
        @if (isAdmin)
        {
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="@Url.Action("Index", "Home", new { area = "" })" class="brand-link">
                <img src="~/dist/img/AdminLTELogo.png" alt="AdminLTE Logo"
                     class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">Baitul Kitab</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column"
                        data-widget="treeview" role="menu" data-accordion="false">

                        <li class="nav-item @(isBookConfigActive ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isBookConfigActive ? "active" : "")">
                                <i class="nav-icon fas fa-cog"></i>
                                <p>
                                    Book Configuration
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>

                            <ul class="nav nav-treeview" style="@(isBookConfigActive ? "display: block;" : "")">
                                <li class="nav-item @(isManagementActive ? "menu-open" : "")">
                                    <a href="#" class="nav-link @(isManagementActive ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>
                                            Management
                                            <i class="right fas fa-angle-left"></i>
                                        </p>
                                    </a>

                                    <ul class="nav nav-treeview" style="@(isManagementActive ? "display: block;" : "")">
                                        <li class="nav-item">
                                            <a href="@Url.Action("Index", "Category", new { area = "Category" })" class="nav-link @(isCategoryActive ? "active" : "")">
                                                <i class="far fa-dot-circle nav-icon"></i>
                                                <p>Category</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="@Url.Action("Add", "Author", new { area = "Author" })" class="nav-link @(isAuthorActive ? "active" : "")">
                                                <i class="fas fa-user nav-icon"></i>
                                                <p>Author</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="@Url.Action("Language", "Language", new { area = "Category" })" class="nav-link @(isLanguageActive ? "active" : "")">
                                                <i class="far fa-dot-circle nav-icon"></i>
                                                <p>Language</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="@Url.Action("Index", "Book", new { area = "Book" })" class="nav-link @(isBookActive ? "active" : "")">
                                                <i class="fas fa-book nav-icon"></i>
                                                <p>Book</p>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </nav>
                <!-- /.sidebar-menu -->

            </div>
            <!-- /.sidebar -->
        </aside>
        }


        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <div class="content-header">
                <div class="@(isAdmin ? "container-fluid" : "container")">
                    @RenderBody()
                </div>
            </div>
        </div>

    </div>

    

    <!-- JS Dependencies -->
    <script src="~/plugins/jquery-ui/jquery-ui.min.js"></script>
    <script>
        $.widget.bridge('uibutton', $.ui.button)
    </script>

    <script src="~/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/plugins/moment/moment.min.js"></script>
    <script src="~/plugins/daterangepicker/daterangepicker.js"></script>
    <script src="~/plugins/summernote/summernote-bs4.min.js"></script>
    <script src="~/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>

    <!-- DataTables -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/jszip/jszip.min.js"></script>
    <script src="~/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>

    <!-- Validation -->
    <script src="~/plugins/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/plugins/jquery-validation/additional-methods.min.js"></script>

    <!-- App JS -->
    <script src="~/dist/js/adminlte.min.js"></script>
    <script src="~/js/toastr.min.js"></script>
    <script src="~/plugins/sweetalert2/sweetalert2.min.js"></script>

    <!-- Custom common scripts -->
    <script src="~/js/common.js"></script>
    <script src="~/js/charts.js"></script>
    <script src="~/js/bootbox.min.js"></script>

    <!-- Sections -->
    @RenderSection("CustomScript", required: false)
    @RenderSection("Scripts", required: false)

    <script>
        $(function () {
            var currentPath = window.location.pathname.toLowerCase();
            $('.nav-sidebar a.nav-link').each(function () {
                var href = $(this).attr('href');
                if (href && href !== '#' && href !== 'javascript:void(0);') {
                    var linkPath = href.split('?')[0].toLowerCase();
                    if (currentPath === linkPath || (linkPath !== '/' && currentPath.indexOf(linkPath) === 0)) {
                        $(this).addClass('active');
                        $(this).parents('.nav-item').addClass('menu-open');
                        $(this).parents('.nav-treeview').css('display', 'block');
                        $(this).parents('.nav-item').children('a.nav-link').addClass('active');
                    }
                }
            });
        });
    </script>
</body>


</html>
