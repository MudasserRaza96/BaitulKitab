@{
    ViewData["Title"] = "My Orders";
}

<section class="content pt-3">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent p-0">
                <li class="breadcrumb-item"><a asp-area="User" asp-controller="Store" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Orders</li>
            </ol>
        </nav>

        <h1 class="h4 mb-3 font-weight-bold">
            <i class="fas fa-box-open text-primary mr-2"></i>My Orders
        </h1>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <div class="my-4">
                    <i class="fas fa-clipboard-list fa-4x text-muted mb-3"></i>
                    <h5 class="font-weight-bold text-dark">No orders placed yet</h5>
                    <p class="text-muted small">You haven't placed any orders yet. Discover our top-selling books today!</p>
                    <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-primary mt-2">
                        <i class="fas fa-shopping-bag mr-1"></i>Start Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
