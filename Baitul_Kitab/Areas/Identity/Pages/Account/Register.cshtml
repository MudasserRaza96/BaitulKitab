@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="vh-100 bg-image"
         style="background-image: url('https://mdbcdn.b-cdn.net/img/Photos/new-templates/search-box/img4.webp');">
    <div class="mask d-flex align-items-center h-100 gradient-custom-3">
        <div class="container h-100">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-12 col-md-9 col-lg-7 col-xl-6">
                    <div class="card" style="border-radius: 15px;">
                        <div class="card-body p-5">
                            <h2 class="text-uppercase text-center mb-3">Create an account</h2>

                            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                                <div class="form-outline mb-2">
                                    <input asp-for="Input.FirstName" class="form-control form-control-lg" placeholder="Enter First Name" />
                                    <label asp-for="Input.FirstName" class="form-label">First Name</label>
                                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                </div>

                                <div class="form-outline mb-2">
                                    <input asp-for="Input.LastName" class="form-control form-control-lg" placeholder="Enter Last Name" />
                                    <label asp-for="Input.LastName" class="form-label">Last Name</label>
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                </div>

                                <div class="form-outline mb-2">
                                    <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="form-outline mb-2">
                                    <input asp-for="Input.Password" class="form-control form-control-lg" placeholder="Password" />
                                    <label asp-for="Input.Password" class="form-label">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>

                                <div class="form-outline mb-2">
                                    <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" placeholder="Confirm Password" />
                                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                                <div class="form-check d-flex mb-2">
                                    <input class="form-check-input me-2" type="checkbox" id="termsCheckbox" required />
                                    <label class="form-check-label" for="termsCheckbox">
                                        I agree all statements in <a href="#" class="text-body"><u>Terms of service</u></a>
                                    </label>
                                </div>

                                <div class="d-flex justify-content-center">
                                    <button id="registerSubmit" type="submit" class="btn btn-success btn-block btn-lg gradient-custom-4 text-body">
                                        Register
                                    </button>
                                </div>

                                <p class="text-center text-muted mt-3 mb-0">
                                    Already have an account? <a href="/Identity/Account/Login" class="fw-bold text-body"><u>Login here</u></a>
                                </p>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
