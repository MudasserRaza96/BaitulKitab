@model IEnumerable<UserFilterOptionDTO>
@{
    ViewData["Title"] = "Authors";
}

<section class="content pt-3">
    <div class="container-fluid">
        @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.TopBanner })

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h4 mb-1 font-weight-bold">Browse by Author</h1>
                <p class="text-muted small mb-0">Discover renowned writers and scholars</p>
            </div>
            <a asp-area="User" asp-controller="Store" asp-action="Books" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-book mr-1"></i>View All Books
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">No authors are available at the moment.</div>
        }
        else
        {
            <div class="row">
                @foreach (var author in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3 mb-3">
                        <div class="card h-100 shadow-sm border-0 text-center p-3 hover-shadow transition">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center p-2">
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="fas fa-user-edit fa-2x text-info"></i>
                                </div>
                                <h6 class="font-weight-bold text-dark mb-1">@author.Name</h6>
                                <span class="badge badge-light border text-muted mb-3">@author.BookCount book(s)</span>
                                <a asp-area="User" asp-controller="Store" asp-action="Books" asp-route-AuthorId="@author.Id" class="btn btn-sm btn-outline-primary btn-block mt-auto">
                                    <i class="fas fa-book-open mr-1"></i>View Books
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @await Component.InvokeAsync("AdPlacement", new { placement = AdPlacements.Footer })
    </div>
</section>
